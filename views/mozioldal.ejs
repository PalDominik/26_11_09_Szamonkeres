<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.title || "no title" %></title>
</head>
<body>
    <h1><%= locals.webTitle || "No webTitle"%></h1>
    <br>
    <form method="post">
        <label>Név:</label>
        <input type="text" name="name" value="<%= locals.body?.name %>"><br>
        <label>Email:</label>
        <input type="text" name="e_mail" value="<%= locals.body?.e_mail %>"><br>
        <label>Dátum:</label>
        <input type="datetime-local" name="date" value="<%= locals.body?.date %>"><br>
        <label>Helyek száma:</label>
        <input type="number" name="reservation" value="<%= locals.body?.reservation %>"><br>
         <% if(locals.errors){ %>
           <% errors.forEach(e => { %>
                <p><%= e %></p>
           <% }) %> 
        <% } %>
        <br>
        <button type="submit">Foglalás</button>
    </form>
    <% if(locals.success){ %>
        <p><%= locals.success %></p>
    <% } %>
</body>
</html>